# JobPilot — the authoritative environment list (`15-infra-and-ops.md` §5).
#
# `AC-FOUND-02.3` / `AC-OPS-05.1`: this file and `Settings` match exactly, both
# directions, asserted by tests/spec/test_env_example_parity.py.
# `AC-OPS-05.2`: no secret has a non-empty value here.
#
# Copy to `.env` and fill in. `.env` is gitignored and never committed.

# --- core --------------------------------------------------------------------
APP_ENV=local
PRODUCT_NAME=JobPilot
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:5173
# openssl rand -hex 32
SECRET_KEY=

# openssl genrsa -out jwt.pem 2048 && openssl rsa -in jwt.pem -pubout
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ISSUER=jobpilot
JWT_AUDIENCE=jobpilot-api
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# openssl rand -hex 32
REFRESH_PEPPER=

# --- data --------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=jobpilot
REDIS_URL=

# --- storage (R2, S3-compatible; MinIO locally) ------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jobpilot-local
R2_PUBLIC_BASE_URL=http://localhost:9000

# --- ai — see 05-ai-layer.md §5 for the isolation rules (HR-6) ---------------
AI_PROVIDER_DEFAULT=gemini
AI_EMBEDDING_PROVIDER=gemini
AI_PROVIDER_RESUME_EXTRACT=
AI_PROVIDER_MATCH_RATIONALE=
AI_PROVIDER_PACK_GENERATE=

# Dedicated Cloud project with its own billing account (AC-AI-05.1).
GEMINI_API_KEY=
# Model ids are configuration, never literals in a .py file (AC-AI-02.2).
# Verified against the provider docs on 2026-09-07. `fast` serves extraction,
# enrichment, rationale, follow-up drafts and answer suggestions; `quality`
# serves pack generation (05-ai-layer.md §5.2). Prices live in
# app/ai/model-pricing.yaml.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_QUALITY=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Host-validated at startup: a base URL is an exfiltration target (AC-AI-05.7).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 05-ai-layer.md §5.4 (D5) — which Gemini terms are in force. On `free`, Google
# may use prompt content to improve their products; the consent copy says so,
# and AC-AI-05.8 fails the build if the two ever disagree.
AI_CONSENT_TIER=free

AI_DAILY_COST_CAP_USD=2
AI_USER_DAILY_CALLS=500
AI_RATIONALE_TOP_N=20
AI_CACHE_TTL_DAYS=7
# 'allow' only during a deliberate re-embedding (AC-AI-02.4).
AI_EMBEDDING_MIGRATION=

# The two stubs; both raise ProviderNotConfigured however they are configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama — the local-development provider (ADR-011). No key, and no resume text
# leaves the machine. Pull the models first:
#   ollama pull llama3.2:3b && ollama pull qwen2.5:7b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_FAST=llama3.2:3b
OLLAMA_MODEL_QUALITY=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- connectors --------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
INGEST_MAX_QUERIES_PER_RUN=40
INGEST_DEFAULT_CRON=0 */6 * * *
CONNECTOR_USER_AGENT=JobPilot/1.0 (+http://localhost:5173/about)

# --- comms -------------------------------------------------------------------
# mailpit locally; resend in staging and production (D7).
EMAIL_PROVIDER=mailpit
RESEND_API_KEY=
EMAIL_FROM=no-reply@localhost
# The bounce webhook fails closed while this is blank (`AC-FOUND-16.6`).
EMAIL_WEBHOOK_SECRET=
# Where mailpit listens locally.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# --- oauth — sign-in only, never reachable from the AI path (HR-6) -----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- observability -----------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
METRICS_TOKEN=

# --- flags — a DB override beats these (ADMIN-03 §3) -------------------------
FLAG_LLM_RATIONALE_ENABLED=false
FLAG_JOB_ENRICHMENT_ENABLED=true
FLAG_OCR_ENABLED=false
FLAG_EXTENSION_APPLY_ENABLED=false
FLAG_DIGEST_ENABLED=false
FLAG_PUSH_ENABLED=false
FLAG_SIGNUP_ENABLED=true
FLAG_INGESTION_ENABLED=true

# --- limits — config, not literals (AC-AUTH-09.6) ----------------------------
RATE_LOGIN_PER_MIN_IP=10
RATE_LOGIN_PER_MIN_EMAIL=5
RATE_GENERAL_PER_MIN_USER=300

# `05-ai-layer.md` §3.1 — optional per-feature daily spend caps. Blank or 0
# means "no cap of its own"; the feature is bound by AI_DAILY_COST_CAP_USD.
AI_FEATURE_CAP_USD__RESUME_EXTRACT=0
AI_FEATURE_CAP_USD__RESUME_QUALITY=0
AI_FEATURE_CAP_USD__JOB_ENRICH=0
AI_FEATURE_CAP_USD__MATCH_RATIONALE=0
AI_FEATURE_CAP_USD__PACK_GENERATE=0
AI_FEATURE_CAP_USD__FOLLOWUP_DRAFT=0
AI_FEATURE_CAP_USD__ANSWER_SUGGEST=0
AI_FEATURE_CAP_USD__EMBED_PROFILE=0
AI_FEATURE_CAP_USD__EMBED_JOB=0
AI_FEATURE_CAP_USD__EMBED_QUESTION=0
# The provider's requests-per-minute limit; the token bucket queues at this rate.
AI_PROVIDER_RPM=15
